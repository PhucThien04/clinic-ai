### ==========================================
### 1. KIỂM TRA SERVER HOẠT ĐỘNG
### ==========================================
GET http://localhost:5000/


### ==========================================
### 2. XÁC THỰC TÀI KHOẢN (AUTH)
### ==========================================

### 2.1. Đăng ký tài khoản mới
POST http://localhost:5000/api/auth/register
Content-Type: application/json

{
  "TenTaiKhoan": "phuc_thien",
  "MatKhau": "123456",
  "HoTen": "Nguyễn Phúc Thiên",
  "CCCD": "054204000627",
  "NgaySinh": "2004-04-26",
  "GioiTinh": "Nam",
  "Email": "phucthiensh@gmail.com",
  "SoDienThoai": "0345113075",
  "DiaChi": "Đà Nẵng",
  "VaiTro": "Bệnh nhân"
}

### 2.2. Đăng nhập hệ thống (Lấy JWT Token)
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "TenTaiKhoan": "nurse_mai",
  "MatKhau": "123456
  "
}


### ==========================================
### 3. QUẢN LÝ LỊCH LÀM VIỆC (SCHEDULES)
### ==========================================

### 3.1. Tạo ca làm việc mới cho Bác sĩ (Trần Văn Hùng - TK26100000003)
POST http://localhost:5000/api/schedules
Content-Type: application/json

{
  "IdBacSi": "TK26100000003",
  "IdPhongKham": "PK26100000001",
  "NgayLamViec": "2026-11-01",
  "GioBatDau": "08:00:00",
  "GioKetThuc": "11:30:00",
  "TrangThai": "Hoạt động",
  "GhiChu": "Ca khám sáng",
  "NguoiCapNhat": "TK26100000002"
}

### 3.2. Lấy danh sách lịch làm việc
GET http://localhost:5000/api/schedules


### ==========================================
### 4. QUẢN LÝ HỒ SƠ BỆNH NHÂN & TIỀN SỬ BỆNH (PATIENTS)
### ==========================================

### 4.1. Tạo hồ sơ bệnh nhân cho tài khoản (phuc_thien - TK26100000006)
POST http://localhost:5000/api/patients/profiles
Content-Type: application/json

{
  "IdTaiKhoan": "TK26100000006",
  "LoaiThongTin": 0,
  "NhietDo": 37.0,
  "HuyetApTamThu": 120,
  "HuyetApTamTruong": 80,
  "NhipTim": 75,
  "NhipTho": 18,
  "CanNang": 65.5,
  "ChieuCao": 170.0,
  "TrieuChung": "Đau nhức răng hàm",
  "ThoiDiemKhoiPhat": "2026-10-25 08:00:00",
  "MucDo": "Trung bình",
  "GhiChu": "Bệnh nhân ê buốt"
}

### 4.2. Lấy danh sách hồ sơ bệnh nhân theo mã tài khoản
GET http://localhost:5000/api/patients/profiles?idTaiKhoan=TK26100000006


### ==========================================
### 5. ĐẶT LỊCH KHÁM (APPOINTMENTS)
### ==========================================

### 5.1. Bệnh nhân tạo lịch đặt khám mới
POST http://localhost:5000/api/appointments
Content-Type: application/json

{
  "IdTaiKhoan": "TK26100000006",
  "IdHoSoBenhNhan": "HS26100000001",
  "IdLichLamViec": "LLV2610000001",
  "LiDoKham": "Đau răng hàm số 8, kiểm tra tổng quát",
  "GhiChu": "Mong muốn khám bác sĩ nam"
}

### 5.2. Lấy danh sách lịch đặt theo tài khoản
GET http://localhost:5000/api/appointments?idTaiKhoan=TK26100000006


### ==========================================
### 6. KHÁM BỆNH & LÂM SÀNG (EXAMINATIONS)
### ==========================================

### 6.1. Y tá cập nhật sinh hiệu / triệu chứng vào hồ sơ khám
PUT http://localhost:5000/api/examinations/vitals
Content-Type: application/json

{
  "idHoSoBenhNhan": "HS26100000001",
  "NhietDo": 36.8,
  "HuyetApTamThu": 118,
  "HuyetApTamTruong": 78,
  "NhipTim": 72,
  "TrieuChung": "Đau nhức răng hàm số 8 khi ăn nhai"
}

### 6.2. Bác sĩ cập nhật chẩn đoán và kết luận khám
PUT http://localhost:5000/api/examinations/diagnosis
Content-Type: application/json

{
  "idHoSoBenhNhan": "HS26100000001",
  "ChuanDoan": "Viêm quanh thân răng khôn hàm dưới bên phải (Răng số 8)",
  "KetLuan": "Chỉ định tiểu phẫu nhổ răng khôn số 8 và kê đơn thuốc giảm đau, kháng viêm."
}


### ==========================================
### 7. QUẢN LÝ PHÒNG KHÁM, SỰ KIỆN & DỊCH VỤ (CLINIC)
### ==========================================

### 7.1. Cập nhật thông tin phòng khám
POST http://localhost:5000/api/clinic/info
Content-Type: application/json

{
  "IdPhongKham": "PK26100000001",
  "ChuPhongKham": "TK26100000001",
  "TenPhongKham": "Nha khoa Đức Tín - Cơ sở chính",
  "DiaChi": "Số 54 Nguyễn Lương Bằng, Đà Nẵng",
  "SoDienThoai": "0236388888",
  "Email": "contact@nhakhoaductin.com",
  "GioiThieu": "Phòng khám nha khoa uy tín hàng đầu Đà Nẵng",
  "GioMoCua": "08:00:00",
  "GioDongCua": "20:00:00"
}

### 7.2. Thêm dịch vụ nha khoa mới
POST http://localhost:5000/api/clinic/services
Content-Type: application/json

{
  "IdPhongKham": "PK26100000001",
  "TenDichVu": "Nhổ răng khôn số 8 tiểu phẫu",
  "MoTa": "Nhổ răng khôn bằng máy siêu âm Piezotome không đau",
  "Gia": 1500000.00,
  "TrangThai": "Hoạt động"
}

### 7.3. Lấy danh sách dịch vụ phòng khám
GET http://localhost:5000/api/clinic/services?idPhongKham=PK26100000001

### 7.4. Tạo sự kiện phòng khám
POST http://localhost:5000/api/clinic/events
Content-Type: application/json

{
  "IdPhongKham": "PK26100000001",
  "TieuDe": "Khám răng tổng quát miễn phí tháng 11",
  "NoiDung": "Chương trình tri ân khách hàng kiểm tra tổng quát miễn phí",
  "TrangThai": "Hiển thị",
  "ThoiGianBatDau": "08:00:00",
  "ThoiGianKetThuc": "17:00:00"
}


### ==========================================
### 8. QUẢN LÝ TIỀN SỬ BỆNH (MEDICAL HISTORY)
### ==========================================

### 8.1. Thêm bản ghi tiền sử bệnh cho hồ sơ bệnh nhân
POST http://localhost:5000/api/patients/histories
Content-Type: application/json

{
  "IdHoSoBenhNhan": "HS26100000001",
  "IdChiTietLD": "CT2610000001",
  "NguoiGhiNhan": "TK26100000004",
  "TenBenh": "Viêm nướu mãn tính",
  "MoTa": "Đã điều trị cao răng năm ngoái",
  "ThoiDiemMac": "2025-05-10 00:00:00",
  "TrangThai": "Đang theo dõi"
}


### ==========================================
### 9. KẾT QUẢ TRỢ LÝ AI (AI RESULTS)
### ==========================================

### 9.1. Lưu kết quả tóm tắt/phân tích từ AI vào lượt khám
POST http://localhost:5000/api/ai/results
Content-Type: application/json

{
  "IdChiTietLD": "CT2610000001",
  "LoaiKetQua": "TOMTAT",
  "NoiDung": "Bệnh nhân có tiền sử viêm nướu, hiện tại đau nhức răng hàm số 8, sinh hiệu ổn định, đề nghị chụp X-quang kiểm tra."
}

### 9.2. Lấy danh sách kết quả AI theo chi tiết lịch đặt
GET http://localhost:5000/api/ai/results?idChiTietLD=CT2610000001


### ==========================================
### 10. TEST QUẢN LÝ NGƯỜI THÂN & TIỀN SỬ BỆNH
### ==========================================

### 10.1. Lấy danh sách tiền sử bệnh theo mã hồ sơ bệnh nhân
GET http://localhost:5000/api/patients/histories?idHoSoBenhNhan=HS26100000001

### 10.2. Lấy danh sách thông tin người thân theo mã hồ sơ bệnh nhân
GET http://localhost:5000/api/patients/relatives?idHoSoBenhNhan=HS26102993560

### 10.3. Cập nhật thông tin người thân
PUT http://localhost:5000/api/patients/relatives
Content-Type: application/json

{
  "IdThongTinNguoiThan": "NT26102973125",
  "MoiQuanHe": "Cha nuôi",
  "HoTen": "Nguyễn Văn Cha",
  "SoDienThoai": "0905999888",
  "DiaChi": "Đà Nẵng"
}